# ==========================================
# Habit Garden - Environment Configuration
# ==========================================
# 1. Copy or rename this file to ".env" in the root directory.
# 2. Replace the placeholder below with your real MongoDB Atlas connection string.
# 3. Do NOT commit your actual ".env" file to version control.

# The port where your local server will listen (defaults to 3000 if omitted)
PORT=3000

# Your MongoDB Atlas connection string
# Example format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/habitgarden?retryWrites=true&w=majority
MONGODB_URI=
